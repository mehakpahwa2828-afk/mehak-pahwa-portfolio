---
interface Props {
  index: string;
  featured: boolean;
  category: string;
  context: string;
  title: string;
  summary: string;
  skills: string[];
  contributions: string[];
  theme: string;
}

const { index, featured, category, context, title, summary, skills, contributions, theme } = Astro.props;
const visualGrammar = index === '01' ? 'system' : index === '02' ? 'planning' : 'gallery';
---

<article id={`project-${index}`} class:list={['project-card', `project-${theme}`, { 'project-featured': featured }]} data-visual-grammar={visualGrammar} data-reveal>
  <div class="project-visual">
    <span class="visual-index">Project / {index}</span>
    {index !== '01' && <div class={`visual-signals signals-${index}`} aria-hidden="true"><span>{index}</span><span>↗</span><span>◎</span><span>{index === '02' ? 'IDEA / SIGNAL' : 'MAKE / SHARE'}</span><div class="signal-poster"><small>{index === '02' ? 'CONTENT SYSTEM' : 'CAMPAIGN SYSTEM'}</small><strong>{index === '02' ? '01—03' : '07'}</strong><p>{index === '02' ? 'Educate · Engage · Publish' : 'Research · Design · Content'}</p></div></div>}
    {index === '01' && (
      <div class="pipeline-visual">
        <div class="pipeline-head"><span>Recruitment flow</span><i>Choose a stage</i></div>
        <div class="pipeline-tabs" role="tablist" aria-label="Recruitment stages">
          <button type="button" role="tab" aria-selected="true" data-stage="applications"><b>01</b><span>Applications</span></button>
          <button type="button" role="tab" aria-selected="false" data-stage="screening"><b>02</b><span>Screening</span></button>
          <button type="button" role="tab" aria-selected="false" data-stage="assignments"><b>03</b><span>Assignments</span></button>
          <button type="button" role="tab" aria-selected="false" data-stage="interviews"><b>04</b><span>Interviews</span></button>
        </div>
        <div class="stage-detail" aria-live="polite"><small>APPLICATIONS</small><p>Tracked incoming activity so the pipeline stayed visible and current.</p></div>
        <button class="pipeline-open" type="button" aria-expanded="false">
          <span>Open case-study interface</span><b aria-hidden="true">↗</b>
        </button>
      </div>
    )}
    {index === '02' && (
      <div class="content-board">
        <button type="button" class="board-note note-a selected" data-content-step="educate"><small>PILLAR 01</small><strong>Educate</strong><span>Useful, clear, credible</span></button>
        <button type="button" class="board-note note-b" data-content-step="engage"><small>PILLAR 02</small><strong>Engage</strong><span>Prompt conversation</span></button>
        <button type="button" class="board-note note-c" data-content-step="publish"><small>PILLAR 03</small><strong>Plan to publish</strong><span>Audience · Format · Rhythm</span></button>
        <svg viewBox="0 0 300 220" role="presentation"><path d="M70 58 C140 20 170 70 220 92 M88 150 C145 190 190 160 222 124" /></svg>
        <div class="board-detail" aria-live="polite"><small>EDUCATE</small><p>Build useful content around topics the audience can understand and apply.</p></div>
        <div class="strategy-chain" aria-label="Content planning logic">
          <button type="button" class="selected" data-strategy-step="audience"><small>01</small><span>Audience</span></button>
          <button type="button" data-strategy-step="platform"><small>02</small><span>Platform</span></button>
          <button type="button" data-strategy-step="format"><small>03</small><span>Format</span></button>
          <button type="button" data-strategy-step="frequency"><small>04</small><span>Frequency</span></button>
        </div>
      </div>
    )}
    {index === '03' && (
      <div class="campaign-visual">
        <button type="button" class="campaign-hero selected" data-campaign-step="content" aria-label="Show campaign content overview">
          <small>FEATURED / 01</small><strong>CONTENT</strong><span>Campaign execution</span><i>Abstract preview</i>
        </button>
        <div class="campaign-stack" aria-label="Six supporting campaign previews">
          {['Research', 'Carousel', 'Canva', 'SEO', 'HTML', 'Publish'].map((label, assetIndex) => (
            <button type="button" style={`--asset:${assetIndex}`} data-campaign-asset={label.toLowerCase()} aria-label={`View ${label} campaign preview`}>
              <small>0{assetIndex + 2}</small><strong>{label}</strong><span>Preview</span>
            </button>
          ))}
        </div>
        <div class="campaign-gallery-nav" aria-label="Select a campaign preview">
          {['Research', 'Carousel', 'Canva', 'SEO', 'HTML', 'Publish'].map((label, assetIndex) => (
            <button type="button" data-campaign-asset-nav={label.toLowerCase()} aria-label={`Select ${label} preview`}><small>0{assetIndex + 2}</small><span>{label}</span></button>
          ))}
        </div>
        <div class="campaign-tags"><span>Canva</span><span>SEO</span><span>HTML</span></div>
        <div class="campaign-detail" aria-live="polite"><small>CONTENT</small><p>Seven social posts, including carousel formats, created as part of the campaign workflow.</p></div>
      </div>
    )}
  </div>
  <div class="project-content">
    <div class="project-heading-row"><p class="eyebrow">{category}</p>{featured && <span>Featured project</span>}</div>
    <h2 class="project-title">{title}</h2>
    <p class="project-summary">{summary}</p>
    <dl class="project-meta">
      <div><dt>Context</dt><dd>{context}</dd></div>
      <div><dt>Key skills</dt><dd>{skills.join(' · ')}</dd></div>
    </dl>
    <div class="project-evidence">
      <p>Evidence</p>
      <div class="contribution-list" aria-label="Project evidence">{contributions.map((item, itemIndex) => <span><b>0{itemIndex + 1}</b>{item}</span>)}</div>
    </div>
    {index !== '01' && <button class="case-study-open" type="button" aria-expanded="false"><span>View case study</span><b aria-hidden="true">↗</b></button>}
  </div>
  {index === '01' && (
    <section class="pipeline-interface" hidden aria-label="Recruitment Operations case-study interface">
      <div class="pipeline-interface-head">
        <span>Recruitment operations / system view</span>
        <button type="button" class="pipeline-close" aria-label="Close case-study interface">Close ×</button>
      </div>
      <div class="pipeline-interface-grid">
        <div><small>01 / INPUT</small><strong>Applications</strong><span>Incoming activity and follow-up visibility</span></div>
        <div><small>02 / CHECK</small><strong>Screening</strong><span>Quality review across each recruitment step</span></div>
        <div><small>03 / TRACK</small><strong>Assignments</strong><span>Daily evaluation, domain and platform tracking</span></div>
        <div><small>04 / REPORT</small><strong>Interviews</strong><span>Scheduling, rounds, outcomes and daily reporting</span></div>
      </div>
      <div class="pipeline-evidence-preview">
        <section class="tracker-mock" aria-label="Reconstructed recruitment tracker preview">
          <header><span>DEMO TRACKER / RECONSTRUCTED</span><b>● LIVE VIEW</b></header>
          <div class="tracker-row tracker-labels"><i>ID</i><i>Stage</i><i>Domain</i><i>Status</i></div>
          <div class="tracker-row"><i>001</i><i>Assignment</i><i>Design</i><i><mark>In review</mark></i></div>
          <div class="tracker-row"><i>002</i><i>R1</i><i>Content</i><i><mark>Scheduled</mark></i></div>
          <div class="tracker-row"><i>003</i><i>Probation</i><i>Operations</i><i><mark>Next stage</mark></i></div>
        </section>
        <figure class="real-evidence-figure">
          <div class="dashboard-preview">
            <img src="/images/work/recruitment-ats-dashboard.png" alt="Recruitment ATS dashboard designed by Mehak, showing a funnel, stage overview, SLA reporting and charts using demonstration figures" loading="lazy" />
          </div>
          <figcaption><small>REAL EVIDENCE / ATS DASHBOARD</small><span>A focused preview of the recruitment funnel, stage movement and SLA monitoring. Figures shown are illustrative.</span></figcaption>
        </figure>
      </div>
      <div class="case-story" aria-label="Recruitment Operations case-study summary">
        <article>
          <small>01 / SITUATION</small>
          <h4>Multiple stages needed one visible operating view.</h4>
          <p>Applications, assignments, interviews and candidate statuses had to remain understandable across daily recruitment activity.</p>
        </article>
        <article>
          <small>02 / WHAT I BUILT</small>
          <h4>A connected tracking and reporting system.</h4>
          <p>Google Sheets trackers, status structures, quality checks and process documentation supported the recruitment workflow.</p>
        </article>
        <article>
          <small>03 / HOW IT WORKED</small>
          <h4>Activity was reviewed stage by stage.</h4>
          <p>Daily and monthly views helped track assignments, interview rounds, domains, platforms, outcomes and movement toward probation.</p>
        </article>
        <article>
          <small>04 / WHAT CHANGED</small>
          <h4>The process became easier to follow.</h4>
          <p>Recruitment activity, handoffs and current statuses could be reviewed through a more consistent and organized structure.</p>
        </article>
      </div>
    </section>
  )}
  {index === '02' && (
    <section class="project-case-study" hidden aria-label="FreshNest Content Strategy case study">
      <div class="pipeline-interface-head"><span>FreshNest / content strategy</span><button type="button" class="case-study-close">Close ×</button></div>
      <div class="case-study-intro"><small>PROJECT OVERVIEW</small><h3>Turning a concept brand brief into a usable content system.</h3><p>The work connected audience thinking, content pillars, formats and publishing rhythm so individual posts belonged to one coherent strategy.</p></div>
      <div class="case-preview case-preview-strategy" aria-label="Reconstructed content strategy preview">
        <header><span>RECONSTRUCTED PREVIEW</span><b>CONTENT SYSTEM</b></header>
        <div><article><small>01</small><strong>Audience</strong><span>Who needs the content?</span></article><i>→</i><article><small>02</small><strong>Pillars</strong><span>Educate · Engage · Activate</span></article><i>→</i><article><small>03</small><strong>Rhythm</strong><span>Platform · Format · Frequency</span></article></div>
      </div>
      <section class="freshnest-evidence" aria-labelledby="freshnest-evidence-title">
        <header>
          <small>SUBMITTED PROJECT MATERIAL</small>
          <h4 id="freshnest-evidence-title">The strategy behind the preview.</h4>
          <p>Selected excerpts from the concept-brand submission and internship report. The strategy document used AI-assisted drafting; the material below is presented as project evidence, not as live campaign performance.</p>
        </header>
        <div class="freshnest-evidence-grid">
          <figure>
            <a href="/images/work/freshnest-strategy-overview.png" target="_blank" rel="noreferrer" aria-label="Open the FreshNest strategy overview at full size">
              <img src="/images/work/freshnest-strategy-overview.png" alt="FreshNest brand overview showing its audience, tone, five content pillars and platform strategy matrix" loading="lazy" decoding="async" />
            </a>
            <figcaption><small>01 / STRATEGY OVERVIEW</small><strong>Brand foundation and five content pillars</strong><span>Shows how the audience, brand tone and content formats were organized into one system.</span></figcaption>
          </figure>
          <figure>
            <a href="/images/work/freshnest-educational-planning.png" target="_blank" rel="noreferrer" aria-label="Open the FreshNest educational-content planning excerpt at full size">
              <img src="/images/work/freshnest-educational-planning.png" alt="FreshNest educational-content planning excerpt with content ideas, platforms, formats and publishing frequency" loading="lazy" decoding="async" />
            </a>
            <figcaption><small>02 / EXECUTION DETAIL</small><strong>Educational content planning</strong><span>Connects content ideas with appropriate platforms, formats and a proposed publishing rhythm.</span></figcaption>
          </figure>
          <article class="freshnest-report-proof">
            <small>03 / INTERNSHIP REPORT EXCERPT</small>
            <h5>Problem → proposed system</h5>
            <blockquote>FreshNest needed a structured, multi-format direction that could engage its audience without becoming repetitive or overly promotional.</blockquote>
            <p>The proposed response was a five-format framework—video, image, educational, influencer and emotional storytelling—with each format serving a distinct role while remaining connected to the same brand theme.</p>
            <span>Concept project · four-week internship · April 2026</span>
          </article>
        </div>
      </section>
      <div class="case-story"><article><small>01 / PROBLEM</small><h4>A brand idea needed a clear content direction.</h4><p>The challenge was to move from a broad objective to content that was relevant, repeatable and suitable for its audience.</p></article><article><small>02 / MY ROLE</small><h4>Research and structure the strategy.</h4><p>I developed audience thinking, content pillars, platform distribution and engagement ideas for the FreshNest concept.</p></article><article><small>03 / SYSTEM</small><h4>Connect each idea to execution.</h4><p>The planning logic linked audience, platform, format and frequency instead of treating posts as isolated pieces.</p></article><article><small>04 / LEARNING</small><h4>Strategy makes creative work more intentional.</h4><p>The project strengthened how I translate objectives into an organized content plan.</p></article></div>
    </section>
  )}
  {index === '03' && (
    <section class="project-case-study" hidden aria-label="Campaign and Creative Execution case study">
      <div class="pipeline-interface-head"><span>Campaign / creative execution</span><button type="button" class="case-study-close">Close ×</button></div>
      <div class="case-study-intro"><small>PROJECT OVERVIEW</small><h3>Moving from research to campaign-ready creative output.</h3><p>The internship combined independent Canva execution with a content calendar and introductory, AI-assisted exposure to SEO and HTML work.</p></div>
      <div class="case-preview case-preview-campaign" aria-label="Reconstructed campaign asset preview">
        <header><span>RECONSTRUCTED PREVIEW</span><b>OUTPUT BOARD / 07 POSTS</b></header>
        <div><article><small>01 / RESEARCH</small><strong>Context</strong><span>Topics and campaign direction</span></article><article><small>02 / DESIGN</small><strong>Canva</strong><span>Posts and carousel formats</span></article><article><small>03 / SUPPORT</small><strong>SEO + HTML</strong><span>AI-assisted learning exposure</span></article></div>
      </div>
      <div class="case-story"><article><small>01 / PROBLEM</small><h4>Campaign ideas needed visual execution.</h4><p>The work required translating research and planned topics into clear social content.</p></article><article><small>02 / MY ROLE</small><h4>Create the visual assets independently.</h4><p>I designed seven Canva posts, including carousel formats, and organized them within a content calendar.</p></article><article><small>03 / APPROACH</small><h4>Research, create, then prepare.</h4><p>The workflow connected topic research, creative design and supporting campaign preparation.</p></article><article><small>04 / LEARNING</small><h4>Creative output works best inside a system.</h4><p>The internship expanded my understanding of how design, SEO and HTML support wider campaign execution.</p></article></div>
    </section>
  )}
</article>
{index === '01' && <script>
  const stageCopy = {
    applications: ['APPLICATIONS', 'Tracked incoming activity so the pipeline stayed visible and current.'],
    screening: ['SCREENING', 'Supported quality checks to keep screening decisions consistent and reliable.'],
    assignments: ['ASSIGNMENTS', 'Monitored assignment activity and maintained accurate status information.'],
    interviews: ['INTERVIEWS', 'Tracked interview and scheduling activity across the recruitment process.'],
  };
  document.querySelectorAll('[data-stage]').forEach((button) => button.addEventListener('click', () => {
    const key = button.getAttribute('data-stage');
    const detail = button.closest('.pipeline-visual')?.querySelector('.stage-detail');
    const copy = key ? stageCopy[key as keyof typeof stageCopy] : undefined;
    button.closest('[role="tablist"]')?.querySelectorAll('[role="tab"]').forEach((tab) => tab.setAttribute('aria-selected', 'false'));
    button.setAttribute('aria-selected', 'true');
    if (detail && copy) detail.innerHTML = `<small>${copy[0]}</small><p>${copy[1]}</p>`;
  }));
  document.querySelectorAll<HTMLButtonElement>('.pipeline-open').forEach((openButton) => {
    const project = openButton.closest('.project-card');
    const panel = project?.querySelector<HTMLElement>('.pipeline-interface');
    const closeButton = project?.querySelector<HTMLButtonElement>('.pipeline-close');
    const setOpen = (isOpen: boolean) => {
      if (!panel) return;
      panel.hidden = !isOpen;
      openButton.setAttribute('aria-expanded', String(isOpen));
      project?.classList.toggle('is-interface-open', isOpen);
      if (isOpen) closeButton?.focus();
      else openButton.focus();
    };
    openButton.addEventListener('click', () => setOpen(true));
    closeButton?.addEventListener('click', () => setOpen(false));
    panel?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.case-study-open').forEach((openButton) => {
    const project = openButton.closest('.project-card');
    const panel = project?.querySelector<HTMLElement>('.project-case-study');
    const closeButton = panel?.querySelector<HTMLButtonElement>('.case-study-close');
    const setOpen = (isOpen: boolean) => {
      if (!panel) return;
      panel.hidden = !isOpen;
      openButton.setAttribute('aria-expanded', String(isOpen));
      project?.classList.toggle('is-case-study-open', isOpen);
      if (isOpen) closeButton?.focus(); else openButton.focus();
    };
    openButton.addEventListener('click', () => setOpen(true));
    closeButton?.addEventListener('click', () => setOpen(false));
    panel?.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
  });
</script>}
{index === '02' && <script>
  const contentCopy = {
    educate: ['EDUCATE', 'Build useful content around topics the audience can understand and apply.'],
    engage: ['ENGAGE', 'Use formats and prompts that invite the audience to respond and participate.'],
    publish: ['PLAN TO PUBLISH', 'Match each idea with an audience, format, platform, and publishing rhythm.'],
  };
  document.querySelectorAll('[data-content-step]').forEach((button) => button.addEventListener('click', () => {
    const key = button.getAttribute('data-content-step');
    const copy = key ? contentCopy[key as keyof typeof contentCopy] : undefined;
    const board = button.closest('.content-board');
    board?.querySelectorAll('[data-content-step]').forEach((item) => item.classList.remove('selected'));
    button.classList.add('selected');
    const detail = board?.querySelector('.board-detail');
    if (detail && copy) detail.innerHTML = `<small>${copy[0]}</small><p>${copy[1]}</p>`;
  }));
  const strategyCopy = {
    audience: ['AUDIENCE', 'Start with who the content needs to help and what they should understand.'],
    platform: ['PLATFORM', 'Choose the channel where that audience and objective can meet naturally.'],
    format: ['FORMAT', 'Shape the idea into the clearest post, carousel or supporting content format.'],
    frequency: ['FREQUENCY', 'Place the content within a repeatable publishing rhythm rather than treating it as a one-off.'],
  };
  document.querySelectorAll('[data-strategy-step]').forEach((button) => button.addEventListener('click', () => {
    const key = button.getAttribute('data-strategy-step');
    const copy = key ? strategyCopy[key as keyof typeof strategyCopy] : undefined;
    const board = button.closest('.content-board');
    board?.querySelectorAll('[data-strategy-step]').forEach((item) => item.classList.remove('selected'));
    button.classList.add('selected');
    const detail = board?.querySelector('.board-detail');
    if (detail && copy) detail.innerHTML = `<small>${copy[0]}</small><p>${copy[1]}</p>`;
  }));
</script>}
{index === '03' && <script>
  const campaignCopy = {
    content: ['CONTENT', 'Seven social posts, including carousel formats, created as part of the campaign workflow.'],
    research: ['RESEARCH', 'Campaign and SEO research helped establish context before creative execution.'],
    carousel: ['CAROUSEL', 'Multi-frame social content was planned as part of the seven-post campaign output.'],
    canva: ['CANVA', 'Canva was used to turn planned ideas into independently created visual posts.'],
    seo: ['SEO', 'SEO work supported the wider digital-marketing learning and execution process.'],
    html: ['HTML', 'HTML was explored with AI assistance as part of the broader internship work.'],
    publish: ['PUBLISH', 'The work connected research, content preparation and visual execution into campaign-ready assets.'],
  };
  document.querySelectorAll('[data-campaign-step], [data-campaign-asset], [data-campaign-asset-nav]').forEach((button) => button.addEventListener('click', () => {
    const key = button.getAttribute('data-campaign-step') ?? button.getAttribute('data-campaign-asset') ?? button.getAttribute('data-campaign-asset-nav');
    const copy = key ? campaignCopy[key as keyof typeof campaignCopy] : undefined;
    const visual = button.closest('.campaign-visual');
    visual?.querySelectorAll('[data-campaign-step], [data-campaign-asset], [data-campaign-asset-nav]').forEach((item) => item.classList.remove('selected'));
    visual?.querySelectorAll(`[data-campaign-asset="${key}"], [data-campaign-asset-nav="${key}"]`).forEach((item) => item.classList.add('selected'));
    if (button.hasAttribute('data-campaign-step')) button.classList.add('selected');
    visual?.classList.add('is-gallery-open');
    const detail = visual?.querySelector('.campaign-detail');
    if (detail && copy) detail.innerHTML = `<small>${copy[0]}</small><p>${copy[1]}</p>`;
  }));
</script>}
