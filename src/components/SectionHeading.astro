---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  copy?: string;
}

const { index, eyebrow, title, copy } = Astro.props;
---

<div class="section-heading" data-reveal>
  <div class="section-label"><span>{index}</span>{eyebrow}</div>
  <div>
    <h2>{title}</h2>
    {copy && <p>{copy}</p>}
  </div>
</div>
