---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { credentials, experience, recognition } from '../data/portfolio';

const orderedExperience = [experience[2], experience[1], experience[0]];
const roleMeta = [
  { capabilities: ['Visual Execution', 'Campaign Support'], asset: '/images/work/alfido-internship-benefits.png', assetAlt: 'Canva campaign post designed during the Alfido Tech internship', artifact: 'Campaign creative', workLink: '/work#project-03' },
  { capabilities: ['Content Strategy', 'Audience Thinking'], asset: '/images/work/freshnest-strategy-overview.png', assetAlt: 'FreshNest content strategy overview', artifact: 'Strategy framework', workLink: '/work#project-02' },
  { capabilities: ['Process Systems', 'Coordination', 'Reporting'], asset: '/images/work/recruitment-dashboard-primary-card.png', assetAlt: 'Aggregate recruitment ATS dashboard view', artifact: 'Operational system', workLink: '/work#project-01' },
];
const allCapabilities = roleMeta.flatMap((item) => item.capabilities);
const recognitionMetrics = ['MERIT', '286/400', '98/100', '#1'];
---

<BaseLayout title="Experience | Mehak Pahwa" description="Experience, education, and recognition for Mehak Pahwa.">
  <div class="site-shell experience-journey-page">
    <Header />
    <main id="main">
      <header class="page-header experience-journey-header" data-reveal>
        <p class="page-kicker"><span></span>Experience</p>
        <div class="experience-header-grid">
          <h1>Learning by taking responsibility for <em>real work.</em></h1>
          <div>
            <p>My roles have moved from content execution into process tracking, quality checks, documentation, and team coordination.</p>
            <span>SCROLL TO TRACE THE JOURNEY</span>
          </div>
        </div>
      </header>

      <section class="career-journey section-space" aria-labelledby="career-journey-title" data-career-journey>
        <div class="section-intro career-journey-intro" data-reveal>
          <p>01 / Career route</p>
          <h2 id="career-journey-title">Responsibility built through practice</h2>
        </div>

        <div class="career-layout">
          <div class="career-route" style="--route-progress: 0">
            <svg class="career-path" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path class="career-path-base" d="M50,1 C58,5 72,8 72,13 S28,27 28,37 S72,51 72,64 S50,76 50,82 L50,98" pathLength="1"></path>
              <path class="career-path-fill" d="M50,1 C58,5 72,8 72,13 S28,27 28,37 S72,51 72,64 S50,76 50,82 L50,98" pathLength="1"></path>
            </svg>

            <div class="journey-guide" data-state="neutral" aria-hidden="true">
              <span class="guide-ring"></span>
              <span class="guide-body"><i></i><i></i><b></b></span>
              <small>GUIDE</small>
            </div>

            {orderedExperience.map((item, index) => (
              <article class:list={['career-milestone', `milestone-${index + 1}`]} data-role-index={index} tabindex="0" aria-labelledby={`role-title-${index}`}>
                <span class="career-node" aria-hidden="true"><i></i><b>0{index + 1}</b></span>
                <div class="career-card">
                  <header><span>0{index + 1} / ROLE</span><time>{item.period}</time></header>
                  <div class="career-card-heading">
                    <p>{index === 0 ? 'CREATIVE EXECUTION' : index === 1 ? 'STRATEGY & PLANNING' : 'OPERATIONS & LEADERSHIP'}</p>
                    <h3 id={`role-title-${index}`}>{item.organisation}</h3>
                    <strong>{item.role}</strong>
                  </div>
                  <p class="career-lead">{item.lead}</p>
                  <ul class="career-evidence-list">{item.evidence.map((point) => <li>{point}</li>)}</ul>
                  <div class="role-capabilities" aria-label="Capabilities acquired in this role">
                    <small>CAPABILITIES ACQUIRED</small>
                    <div>{roleMeta[index].capabilities.map((capability) => <span data-capability={capability}>{capability}</span>)}</div>
                  </div>
                  <figure class="career-artifact">
                    <a href={roleMeta[index].workLink} aria-label={`View ${item.organisation} project evidence on the Work page`}>
                      <img src={roleMeta[index].asset} alt={roleMeta[index].assetAlt} loading={index === 0 ? 'eager' : 'lazy'} />
                      <span><small>0{index + 1} / EVIDENCE</small><strong>{roleMeta[index].artifact}</strong><i aria-hidden="true">↗</i></span>
                    </a>
                  </figure>
                </div>
              </article>
            ))}

          </div>

          <aside class="capability-inventory" aria-live="polite" aria-atomic="false">
            <header><span>CAPABILITIES ACQUIRED</span><b data-capability-count>00/07</b></header>
            <div data-capability-inventory><p data-capability-empty>Capabilities appear as the journey unfolds.</p></div>
          </aside>
        </div>
      </section>

      <section id="education" class="education-section section-space experience-foundation">
        <div class="section-intro" data-reveal><p>02 / Foundation</p><h2>Education and professional development</h2></div>
        <div class="education-grid credential-shelf" aria-label="Education and professional credentials">
          {credentials.map((item, index) => <article data-reveal tabindex="0"><i aria-hidden="true">0{index + 1}</i><span>{item.year}</span><h3>{item.title}</h3><p>{item.source}</p><small>{item.detail}</small></article>)}
        </div>
      </section>

      <section id="recognition" class="achievement-vault section-space" data-achievement-vault aria-labelledby="achievement-title">
        <span class="journey-guide vault-guide" data-state="neutral" aria-hidden="true"><span class="guide-ring"></span><span class="guide-body"><i></i><i></i><b></b></span><small>GUIDE</small></span>
        <div class="vault-heading" data-reveal>
          <div><p>03 / Recognition</p><span>ACHIEVEMENTS <b data-achievement-count>00 / 04</b></span></div>
          <h2 id="achievement-title">Achievement Vault</h2>
          <p>Academic evidence, revealed through the journey.</p>
        </div>
        <div class="vault-grid">
          {recognition.map((item, index) => (
            <article class="vault-marker" data-achievement-index={index} tabindex="0" aria-labelledby={`achievement-${index}`}>
              <header><span>0{index + 1}</span><small data-vault-state>SEALED</small></header>
              <strong>{recognitionMetrics[index]}</strong>
              <h3 id={`achievement-${index}`}>{item.title}</h3>
              <p>{item.detail}</p>
              <i aria-hidden="true"></i>
            </article>
          ))}
        </div>
        <p class="vault-complete" data-vault-complete hidden>ACHIEVEMENTS DISCOVERED · 04/04</p>
      </section>

      <section class="career-now" data-now-node tabindex="0" aria-labelledby="career-now-title">
        <span class="career-node now-node" aria-hidden="true"><i></i><b>NOW</b></span>
        <span class="journey-guide final-journey-guide" data-state="settled" aria-hidden="true"><span class="guide-ring"></span><span class="guide-body"><i></i><i></i><b></b></span><small>GUIDE</small></span>
        <div>
          <p>CURRENT POINT / STILL IN PROGRESS</p>
          <h2 id="career-now-title">The journey is still being built.</h2>
          <div class="now-status">
            <span>Career journey · <b data-final-career>00/03</b> explored</span>
            <span>Capabilities · <b data-final-capabilities>00/07</b> acquired</span>
            <span>Achievements · <b data-final-achievements>00/04</b> discovered</span>
          </div>
          <div class="now-capabilities" aria-label="Capabilities collected through the career journey">
            <small>CAPABILITY STACK</small>
            <div>{allCapabilities.map((capability) => <span data-final-capability={capability}>{capability}</span>)}</div>
          </div>
          <a class="button button-primary" href="/about"><span>Next: How I think &amp; work</span><b aria-hidden="true">→</b></a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  const journey = document.querySelector<HTMLElement>('[data-career-journey]');
  const route = journey?.querySelector<HTMLElement>('.career-route');
  const routePath = route?.querySelector<SVGPathElement>('.career-path-fill');
  const guide = route?.querySelector<HTMLElement>('.journey-guide');
  const milestones = [...(route?.querySelectorAll<HTMLElement>('[data-role-index]') ?? [])];
  const nowNode = document.querySelector<HTMLElement>('[data-now-node]');
  const inventory = journey?.querySelector<HTMLElement>('[data-capability-inventory]');
  const capabilityCount = journey?.querySelector<HTMLElement>('[data-capability-count]');
  const capabilityEmpty = journey?.querySelector<HTMLElement>('[data-capability-empty]');
  const finalCareer = document.querySelector<HTMLElement>('[data-final-career]');
  const finalCapabilities = document.querySelector<HTMLElement>('[data-final-capabilities]');
  const finalAchievements = document.querySelector<HTMLElement>('[data-final-achievements]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const compactMotion = window.matchMedia('(max-width: 820px)');
  const acquiredCapabilities = new Set<string>();
  const exploredRoles = new Set<number>();
  const routeStops = [.18, .5, .83, .96];
  const guideStops = [[72, 13], [28, 37], [72, 64], [50, 98]];
  const guideTimers = new Set<number>();
  const flightTokens = new Set<HTMLElement>();
  let activeSequence = 0;
  let pendingRole: HTMLElement | null = null;

  const queueGuideStep = (callback: () => void, delay: number) => {
    const timer = window.setTimeout(() => {
      guideTimers.delete(timer);
      callback();
    }, delay);
    guideTimers.add(timer);
  };

  const clearGuideSequence = () => {
    guideTimers.forEach((timer) => window.clearTimeout(timer));
    guideTimers.clear();
    flightTokens.forEach((token) => token.remove());
    flightTokens.clear();
  };

  const setGuideState = (state: 'neutral' | 'focused' | 'capability' | 'settled', direction = 0, offPath = false) => {
    if (!guide) return;
    guide.dataset.state = state;
    guide.style.setProperty('--guide-look', String(direction));
    guide.style.setProperty('--guide-peek', `${direction * 18}px`);
    guide.classList.toggle('is-off-path', offPath);
  };

  const placeGuide = (progress: number, stopIndex?: number) => {
    if (!routePath || !guide) return;
    const point = stopIndex === undefined
      ? routePath.getPointAtLength(routePath.getTotalLength() * progress)
      : { x: guideStops[stopIndex][0], y: guideStops[stopIndex][1] };
    guide.style.setProperty('--guide-x', `${point.x}%`);
    guide.style.setProperty('--guide-y', `${point.y}%`);
  };

  const addCapability = (label: string, order = 0, animate = true) => {
    if (!label || acquiredCapabilities.has(label) || !inventory) return;
    acquiredCapabilities.add(label);
    capabilityEmpty?.remove();
    const chip = document.createElement('span');
    chip.textContent = label;
    chip.className = 'inventory-chip';
    if (animate && !reduceMotion.matches) {
      chip.classList.add('is-arriving');
      chip.style.animationDelay = `${order * 70}ms`;
    }
    inventory.append(chip);
    if (capabilityCount) capabilityCount.textContent = `${String(acquiredCapabilities.size).padStart(2, '0')}/07`;
    if (finalCapabilities) finalCapabilities.textContent = `${String(acquiredCapabilities.size).padStart(2, '0')}/07`;
    document.querySelector<HTMLElement>(`[data-final-capability="${CSS.escape(label)}"]`)?.classList.add('is-collected');
  };

  const unlockRole = (role: HTMLElement, animateInventory = true) => {
    const index = Number(role.dataset.roleIndex ?? 0);
    if (exploredRoles.has(index)) return;
    exploredRoles.add(index);
    role.classList.add('is-explored');
    role.querySelectorAll<HTMLElement>('[data-capability]').forEach((chip, chipIndex) => addCapability(chip.dataset.capability ?? '', chipIndex, animateInventory));
    if (finalCareer) finalCareer.textContent = `${String(exploredRoles.size).padStart(2, '0')}/03`;
  };

  const collectRoleCapabilities = (role: HTMLElement, sequence: number) => {
    const sourceChips = [...role.querySelectorAll<HTMLElement>('[data-capability]')]
      .filter((chip) => !acquiredCapabilities.has(chip.dataset.capability ?? ''));
    const target = capabilityCount?.getBoundingClientRect();
    if (!sourceChips.length || !target || reduceMotion.matches || compactMotion.matches) {
      unlockRole(role, false);
      setGuideState('settled');
      pendingRole = null;
      return;
    }

    sourceChips.forEach((chip, index) => {
      const source = chip.getBoundingClientRect();
      const token = document.createElement('span');
      token.className = 'capability-flight';
      token.textContent = chip.dataset.capability ?? '';
      token.style.left = `${source.left + source.width / 2}px`;
      token.style.top = `${source.top + source.height / 2}px`;
      token.style.setProperty('--flight-x', `${target.left + target.width / 2 - source.left - source.width / 2}px`);
      token.style.setProperty('--flight-y', `${target.top + target.height / 2 - source.top - source.height / 2}px`);
      token.style.animationDelay = `${index * 30}ms`;
      document.body.append(token);
      flightTokens.add(token);
      token.addEventListener('animationend', () => {
        flightTokens.delete(token);
        token.remove();
      }, { once: true });
    });

    queueGuideStep(() => {
      if (sequence !== activeSequence) return;
      unlockRole(role, false);
      setGuideState('settled', 0, false);
      pendingRole = null;
    }, 250 + Math.max(0, sourceChips.length - 1) * 30);
  };

  const activateRole = (role: HTMLElement) => {
    const index = Number(role.dataset.roleIndex ?? 0);
    const direction = index === 1 ? 1 : -1;
    if (pendingRole && pendingRole !== role) unlockRole(pendingRole, false);
    clearGuideSequence();
    const sequence = ++activeSequence;
    pendingRole = role;
    milestones.forEach((item) => {
      item.classList.remove('is-active', 'is-capabilities-visible');
    });
    route?.style.setProperty('--route-progress', String(routeStops[index]));
    setGuideState('neutral');
    guide?.classList.add('is-travelling');
    placeGuide(routeStops[index], index);

    if (reduceMotion.matches) {
      guide?.classList.remove('is-travelling');
      role.classList.add('is-active', 'is-capabilities-visible');
      unlockRole(role, false);
      setGuideState('settled');
      pendingRole = null;
      return;
    }

    queueGuideStep(() => {
      if (sequence !== activeSequence) return;
      guide?.classList.remove('is-travelling');
      setGuideState('focused', direction, true);
    }, 300);
    queueGuideStep(() => {
      if (sequence !== activeSequence) return;
      role.classList.add('is-active');
    }, 390);
    queueGuideStep(() => {
      if (sequence !== activeSequence) return;
      role.classList.add('is-capabilities-visible');
      setGuideState('capability', direction, true);
    }, 490);
    queueGuideStep(() => {
      if (sequence !== activeSequence) return;
      collectRoleCapabilities(role, sequence);
    }, 560);
  };

  if (route && milestones.length) {
    placeGuide(.015);
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      milestones.forEach((role) => unlockRole(role, false));
      const lastRole = milestones.at(-1);
      if (lastRole) {
        milestones.forEach((item) => item.classList.toggle('is-active', item === lastRole));
        lastRole.classList.add('is-capabilities-visible');
      }
      nowNode?.classList.add('is-active');
      route.style.setProperty('--route-progress', '1');
      placeGuide(.96, 3);
      setGuideState('settled');
    } else {
      const roleObserver = new IntersectionObserver((entries) => {
        entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio).slice(0, 1).forEach((entry) => activateRole(entry.target as HTMLElement));
      }, { rootMargin: '-25% 0px -38% 0px', threshold: [.15, .35, .6] });
      milestones.forEach((role) => {
        roleObserver.observe(role);
        role.addEventListener('focusin', () => activateRole(role));
      });
      const unlockPassedRoles = () => milestones.forEach((role) => {
        if (role.getBoundingClientRect().top < 0) unlockRole(role, false);
      });
      addEventListener('scroll', unlockPassedRoles, { passive: true });
      unlockPassedRoles();
      if (nowNode) {
        const nowObserver = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          milestones.forEach((item) => item.classList.remove('is-active'));
          if (pendingRole) unlockRole(pendingRole, false);
          clearGuideSequence();
          pendingRole = null;
          nowNode.classList.add('is-active');
          route.style.setProperty('--route-progress', '1');
          setGuideState('settled');
          placeGuide(.96, 3);
        }, { rootMargin: '-20% 0px -25% 0px', threshold: .35 });
        nowObserver.observe(nowNode);
        nowNode.addEventListener('focusin', () => { route.style.setProperty('--route-progress', '1'); setGuideState('settled'); placeGuide(.96, 3); });
      }
    }
  }

  const vault = document.querySelector<HTMLElement>('[data-achievement-vault]');
  const achievements = [...(vault?.querySelectorAll<HTMLElement>('[data-achievement-index]') ?? [])];
  const vaultCount = vault?.querySelector<HTMLElement>('[data-achievement-count]');
  const vaultComplete = vault?.querySelector<HTMLElement>('[data-vault-complete]');
  const vaultGuide = vault?.querySelector<HTMLElement>('.vault-guide');
  let vaultGuideTimer = 0;
  const discoveredAchievements = new Set<number>();
  const acknowledgeAchievement = (index: number) => {
    if (!vaultGuide || reduceMotion.matches) return;
    window.clearTimeout(vaultGuideTimer);
    vaultGuide.style.setProperty('--vault-shift', `${(index - 1.5) * 7}px`);
    vaultGuide.dataset.state = 'focused';
    vaultGuide.classList.add('is-scanning');
    vaultGuideTimer = window.setTimeout(() => {
      vaultGuide.dataset.state = 'capability';
      vaultGuideTimer = window.setTimeout(() => {
        vaultGuide.dataset.state = 'settled';
        vaultGuide.classList.remove('is-scanning');
      }, 260);
    }, 260);
  };
  const unlockAchievement = (marker: HTMLElement) => {
    const index = Number(marker.dataset.achievementIndex ?? 0);
    if (discoveredAchievements.has(index)) return;
    discoveredAchievements.add(index);
    marker.classList.add('is-unlocked');
    acknowledgeAchievement(index);
    const state = marker.querySelector<HTMLElement>('[data-vault-state]');
    if (state) state.textContent = 'DISCOVERED';
    const count = discoveredAchievements.size;
    if (vaultCount) vaultCount.textContent = `${String(count).padStart(2, '0')} / 04`;
    if (finalAchievements) finalAchievements.textContent = `${String(count).padStart(2, '0')}/04`;
    if (count === achievements.length && vaultComplete) vaultComplete.hidden = false;
  };
  if (achievements.length) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) achievements.forEach(unlockAchievement);
    else {
      const achievementObserver = new IntersectionObserver((entries) => {
        entries.filter((entry) => entry.isIntersecting).forEach((entry) => unlockAchievement(entry.target as HTMLElement));
      }, { rootMargin: '-12% 0px -18% 0px', threshold: .42 });
      achievements.forEach((marker) => { achievementObserver.observe(marker); marker.addEventListener('focusin', () => unlockAchievement(marker)); });
      const unlockPassedAchievements = () => achievements.forEach((marker) => {
        if (marker.getBoundingClientRect().top < innerHeight * .8) unlockAchievement(marker);
      });
      addEventListener('scroll', unlockPassedAchievements, { passive: true });
      unlockPassedAchievements();
    }
  }
</script>
