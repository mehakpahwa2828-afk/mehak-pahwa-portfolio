---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/portfolio';
---
<BaseLayout title="Selected Work | Mehak Pahwa" description="Selected operations and digital marketing work by Mehak Pahwa."><div class="site-shell"><Header /><main id="main"><header class="page-header" data-reveal><p class="page-kicker"><span></span>Selected work</p><h1>Work that made information <em>more useful.</em></h1><p>These projects show what I was responsible for, how I approached the work, and which tools supported it.</p></header><div class="work-marquee" data-reveal aria-hidden="true"><div><span>PROCESS DESIGN</span><i>✦</i><span>CONTENT THINKING</span><i>✦</i><span>QUALITY CHECKS</span><i>✦</i><span>VISUAL EXECUTION</span><i>✦</i><span>PROCESS DESIGN</span><i>✦</i><span>CONTENT THINKING</span></div></div><section class="work-list">{projects.map((project) => <ProjectCard {...project} />)}</section><section class="page-cta compact" data-reveal><p>Want the role-level context?</p><h2>See where this work fits in my experience.</h2><div><a href="/experience">View experience ↗</a><a href="/about">Capabilities ↗</a></div></section></main><Footer /></div></BaseLayout>
